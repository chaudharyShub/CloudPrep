# Copy to .env.local (git-ignored) and fill in from Supabase: Project Settings → API keys.

# Used by `npm run publish:questions` only. The secret key (or legacy service_role key)
# bypasses Row Level Security: never commit it and never give it a VITE_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Used by `npm run admin:add` only: the account(s) to make admins, comma-separated.
# Never give it a VITE_ prefix: the app doesn't need it, and VITE_ values are public.
ADMIN_EMAIL=

# Used by the app from step 2 (auth). The publishable (or legacy anon) key is safe in the browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Shows "Email me a sign-in link". Only set it once custom SMTP is set up in Supabase.
# VITE_EMAIL_SIGN_IN=true
