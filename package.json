{
  "name": "cloudprep",
  "private": true,
  "version": "2.2.0",
  "description": "Unofficial AWS Certified Cloud Practitioner (CLF-C02) practice exam simulator.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:proctor": "node scripts/setup-proctor-assets.mjs",
    "predev": "node scripts/setup-proctor-assets.mjs",
    "prebuild": "node scripts/setup-proctor-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prebuild:e2e": "node scripts/setup-proctor-assets.mjs",
    "build:e2e": "tsc -b && vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run validate:questions && npm run test && npm run build && npm run test:e2e",
    "validate:questions": "node scripts/validate-questions.mjs",
    "publish:questions": "node --env-file-if-exists=.env.local scripts/publish-questions.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "check:published": "node --env-file-if-exists=.env.local scripts/check-published.mjs",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
